# dependencies / build output (also covered by per-app .gitignore)
node_modules/
.next/
dist/
.runtime/

# env / secrets
.env
.env.*

# logs
*.log

# local databases / dumps
backups/

# preserved legacy history of the backend (pre-monorepo)
petro/.git.bak/

# design/QA artifacts (kept on disk, not tracked)
reference-design/*.png
front/imports/
front/*-profile/
front/*.png
front/*.pdf
front/*.svg
front/*.zip

front/package-lock.json
