{
  "name": "eco-times-monorepo",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:backend": "npm --prefix petro run dev",
    "dev:front": "npm --prefix front run dev",
    "build": "npm run build:backend && npm run build:front",
    "build:backend": "npm --prefix petro run build",
    "build:front": "npm --prefix front run build",
    "start": "node scripts/start.mjs"
  }
}
