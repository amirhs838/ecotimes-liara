// EcoTimes CMS schema
// PostgreSQL (local dev: ecotimes_dev / production: cloud Postgres via DATABASE_URL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Auth ----------

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ---------- Taxonomy ----------

model Category {
  id             String         @id @default(cuid())
  name           String         @unique // e.g. "هوش مصنوعی"
  slug           String         @unique // e.g. "ai"
  order          Int            @default(0) // navigation order
  posts          Post[]
  postCategories PostCategory[]
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  slug  String    @unique
  posts PostTag[]
}

model PostTag {
  postId String
  tagId  String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// A post may belong to several categories at once; categoryId on Post stays
// the PRIMARY (main) category — the one shown above news on the homepage.
model PostCategory {
  postId     String
  categoryId String
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([postId, categoryId])
  @@index([categoryId])
}

// ---------- Media ----------

model Media {
  id             String   @id @default(cuid())
  key            String   @unique // storage key (uuid + ext)
  url            String // public URL (/api/media/<key> for local, absolute for blob)
  provider       String // "local" | "blob"
  kind           String // "image" | "video"
  mimeType       String
  size           Int // bytes
  width          Int?
  height         Int?
  alt            String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  homeImagePosts  Post[] @relation("HomeImage")
  innerImagePosts Post[] @relation("InnerImage")
  ogImagePosts    Post[] @relation("OgImage")
}

// ---------- Posts ----------

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum VideoType {
  NONE
  UPLOAD
  APARAT
  YOUTUBE
}

model Post {
  id     String @id @default(cuid())
  slug   String @unique

  // Content
  kicker String? // روتیتر (optional)
  title  String
  lead   String
  body   String // sanitized HTML from rich text editor

  // Images
  homeImageId  String?
  homeImage    Media?  @relation("HomeImage", fields: [homeImageId], references: [id], onDelete: SetNull)
  homeImageAlt String  @default("")
  innerImageId  String?
  innerImage    Media?  @relation("InnerImage", fields: [innerImageId], references: [id], onDelete: SetNull)
  innerImageAlt String  @default("")

  // Video (for video-type posts)
  videoType     VideoType @default(NONE)
  videoUrl      String? // uploaded file URL or external embed URL
  videoDuration Int? // seconds

  // Homepage video — plays in place of the homepage image (golden rule 9).
  // Separate from the post's own video: this one is specific to homepage cards.
  homepageVideoType VideoType @default(NONE)
  homepageVideoUrl  String? // uploaded file URL or external (Aparat/YouTube) link

  // Taxonomy
  categoryId String // PRIMARY (main) category — shown on homepage labels
  category   Category @relation(fields: [categoryId], references: [id])
  postCategories PostCategory[]
  tags       PostTag[]

  // Publishing
  status      PostStatus @default(DRAFT)
  publishedAt DateTime
  hasOwnPage  Boolean    @default(true)
  views       Int        @default(0)

  // SEO
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  ogImageId       String?
  ogImage         Media?  @relation("OgImage", fields: [ogImageId], references: [id], onDelete: SetNull)
  canonicalUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  placements SectionPlacement[]

  @@index([status, publishedAt])
  @@index([categoryId, status, publishedAt])
  @@index([views])
}

// ---------- Live stream (admin-toggled homepage section) ----------

model LiveStream {
  id        String   @id @default(cuid())
  enabled   Boolean  @default(false) // master switch: shows/hides the homepage section
  title     String   @default("پخش زنده")
  aparatUrl String   @default("") // Aparat live link or embed URL
  updatedAt DateTime @updatedAt
}

// ---------- Homepage layout ----------

// Singleton snapshot (id = 1) of the last-known-good crypto ticker values.
// Kept in the DB so every serverless instance (and cold start) can serve real
// prices even when the Binance/CoinGecko upstreams are unreachable from
// Vercel's region — the frontend then never falls back to "—".
model MarketSnapshot {
  id        Int      @id @default(1)
  items     Json
  updatedAt DateTime @updatedAt
}

model HomeSection {
  id         String  @id @default(cuid())
  key        String  @unique // "breaking" | "hero" | "videos" | "photos" | "feature" | category slugs ("ai", "energy", ...)
  name       String // Persian display name, e.g. "اخبار فوری"
  capacity   Int     @default(5) // informational: how many positions the frontend renders
  order      Int     @default(0) // display order matching the frontend (3002) layout
  placements SectionPlacement[]
}

model SectionPlacement {
  id        String      @id @default(cuid())
  sectionId String
  postId    String
  position  Int
  section   HomeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  post      Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  // One position per section; a post may still appear in many sections
  // and even multiple times in the same section (different positions).
  @@unique([sectionId, position])
  @@index([postId])
}

// ---------- Chunked upload staging (flaky-network uploads) ----------
// The browser uploads a file in many small pieces; the server stages them in
// the DB (no Vercel Blob / object storage involved) and assembles the final
// object into the object storage when all pieces have arrived.

model UploadSession {
  id           String   @id @default(cuid())
  kind         String // "image" | "video"
  mimeType     String
  expectedSize Int
  chunkSize    Int // bytes per chunk
  createdAt    DateTime @default(now())
  chunks       UploadChunk[]
}

model UploadChunk {
  uploadId String
  index    Int
  data     Bytes
  upload   UploadSession @relation(fields: [uploadId], references: [id], onDelete: Cascade)

  @@id([uploadId, index])
}
